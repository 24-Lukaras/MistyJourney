@page
@model CreateGameModel
@{
    ViewData["Title"] = "Create Game";
}

<h2>Create New Game</h2>

<form method="post" class="create-game-form">
    <div class="form-group">
        <label for="CharacterName" class="form-label">Character Name</label>
        <input type="text" id="CharacterName" name="CharacterName" class="form-input" required 
               placeholder="Enter your character's name" />
    </div>
    
    <div class="form-group">
        <label for="Localization" class="form-label">Localization</label>
        <select id="Localization" name="Localization" class="form-select" required>
            <option value="">Select language</option>
            <option value="en">English</option>
            <option value="cs">Czech</option>
        </select>
    </div>
    
    <button type="submit" class="form-submit">Start Game</button>
</form>
