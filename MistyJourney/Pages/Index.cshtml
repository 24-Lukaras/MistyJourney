@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h2>Choose save file</h2>
<div class="savefile-carousel-container">
    <div class="savefile-card add-card" onclick="window.location = '/CreateGame'">+ New</div>
    <div class="savefile-carousel">
        @foreach (var save in Model.Saves)
        {
            <div class="savefile-card" onclick="window.location = '/Game/@save.CharacterName'">
                <div class="savefile-name">@save.CharacterName</div>
            </div>
        }
    </div>
</div>
